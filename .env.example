# Copy this file to ".env" and fill in your own keys, or leave it and add them in the
# app's Settings (gear icon) instead. All keys are free; only TMDB is really needed.

# https://www.themoviedb.org/settings/api  (movie search + TMDB artwork)
TMDB_KEY=

# https://fanart.tv/get-an-api-key/  (logos, ClearArt, disc art)
FANART_KEY=

# https://thetvdb.com/api-information  (optional; PIN only if your key needs one)
TVDB_KEY=
TVDB_PIN=

# https://serpapi.com  (optional; Google Images results inside the app)
SERPAPI_KEY=

# Port the app is reachable on (http://localhost:4321 by default)
PORT=4321
